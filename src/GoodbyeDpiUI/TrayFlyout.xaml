<Window x:Class="GoodbyeDpiUI.TrayFlyout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GoodbyeDPI"
        Width="300"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="{DynamicResource UiFont}"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}">

    <Window.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    </Window.Resources>

    <Border BorderThickness="1" BorderBrush="{DynamicResource StrokeBrush}">
        <StackPanel x:Name="Root" Margin="16,14,16,14">
            <StackPanel.RenderTransform>
                <TranslateTransform x:Name="RootShift" Y="8" />
            </StackPanel.RenderTransform>

            <!-- =========================================== durum basligi -->
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="9" Height="9" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsConnecting}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <TextBlock Text="{Binding StatusText}"
                               Margin="9,0,0,0"
                               FontSize="15" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextBrush}" />
                </StackPanel>

                <!-- Ana pencereyi ac -->
                <Button HorizontalAlignment="Right"
                        Style="{StaticResource TitleBarButton}"
                        Click="Open_Click"
                        ToolTip="Pencereyi ac">
                    <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="12" />
                </Button>
            </Grid>

            <TextBlock Text="{Binding ProfileSummary}"
                       FontSize="11" Margin="18,1,0,0"
                       Foreground="{DynamicResource TextMutedBrush}" />

            <!-- ============================================ ana eylem -->
            <Button Style="{StaticResource PrimaryButton}"
                    Command="{Binding ToggleConnectionCommand}"
                    Margin="0,14,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource IconFont}"
                               FontSize="13" VerticalAlignment="Center" />
                    <TextBlock Margin="8,0,0,0" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Baglan" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Text" Value="Baglantiyi Kes" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsConnecting}" Value="True">
                                        <Setter Property="Text" Value="Durdur" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Button>

            <!-- ============================================== profiller -->
            <TextBlock Text="YONTEM" FontSize="10" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,16,0,7" />
            <ListBox Style="{StaticResource PillList}"
                     ItemsSource="{Binding Methods}"
                     SelectedItem="{Binding SelectedMethod, Mode=TwoWay}"
                     DisplayMemberPath="Name" />

            <TextBlock Text="DNS" FontSize="10" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,7" />
            <ListBox Style="{StaticResource PillList}"
                     ItemsSource="{Binding DnsProfiles}"
                     SelectedItem="{Binding SelectedDns, Mode=TwoWay}"
                     DisplayMemberPath="Name" />

            <Border Height="1" Background="{DynamicResource StrokeBrush}" Margin="0,12,0,0" />

            <!-- ================================================ alt sira -->
            <Grid Margin="0,10,0,0">
                <Button Style="{StaticResource GhostButton}"
                        HorizontalAlignment="Left"
                        Click="Open_Click"
                        Content="Pencereyi Goster" />

                <Button Style="{StaticResource GhostButton}"
                        HorizontalAlignment="Right"
                        Click="Exit_Click"
                        Content="Cikis"
                        Tag="danger" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
