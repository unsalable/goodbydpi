<Window x:Class="GoodbyeDpiUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GoodbyeDPI"
        Width="400"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="{DynamicResource UiFont}"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}">

    <Window.Resources>
        <!-- Simge fontu: Windows 11'de Fluent, 10'da MDL2'ye duser. -->
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    </Window.Resources>

    <!-- Acilista yumusak beliris: hafif yukari kayarak solgunluktan gelir. -->
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="RootPanel"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.32" />
                    <DoubleAnimation Storyboard.TargetName="RootShift"
                                     Storyboard.TargetProperty="Y"
                                     From="12" To="0" Duration="0:0:0.42">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid>
        <Grid x:Name="RootPanel" Opacity="0">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="RootShift" Y="12" />
            </Grid.RenderTransform>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============================================== baslik cubugu -->
            <Grid Grid.Row="0" Height="46" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="16,0,0,0">
                    <Ellipse Width="9" Height="9" Fill="{DynamicResource AccentGradient}" />
                    <TextBlock Text="GoodbyeDPI" Margin="9,0,0,0"
                               FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,8,0">

                    <!-- Tema -->
                    <Button Style="{StaticResource TitleBarButton}"
                            Click="Theme_Click"
                            ToolTip="Temayi degistir">
                        <TextBlock FontFamily="{StaticResource IconFont}" FontSize="14">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE708;" /><!-- ay -->
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDark}" Value="True">
                                            <Setter Property="Text" Value="&#xE706;" /><!-- gunes -->
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>

                    <!-- Ayarlar -->
                    <ToggleButton x:Name="SettingsToggle"
                                  Width="34" Height="28" Cursor="Hand" Focusable="False"
                                  Foreground="{DynamicResource TextMutedBrush}"
                                  ToolTip="Ayarlar">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="7">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="14" />
                    </ToggleButton>

                    <Button Style="{StaticResource TitleBarButton}" Click="Minimize_Click" ToolTip="Kucult">
                        <TextBlock Text="&#xE921;" FontFamily="{StaticResource IconFont}" FontSize="11" />
                    </Button>

                    <Button Style="{StaticResource CloseButton}" Click="Close_Click" ToolTip="Tepsiye kucult">
                        <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource IconFont}" FontSize="11" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ===================================================== govde -->
            <StackPanel Grid.Row="1" Margin="24,4,24,24">

                <Button Style="{StaticResource PowerButton}"
                        Command="{Binding ToggleConnectionCommand}"
                        HorizontalAlignment="Center"
                        Margin="0,10,0,0" />

                <!-- Durum -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,0">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsConnecting}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <TextBlock Text="{Binding StatusText}"
                               Margin="8,0,0,0"
                               FontSize="17" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextBrush}" />
                </StackPanel>

                <TextBlock Text="{Binding StatusDetail}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="320"
                           Margin="0,6,0,0"
                           FontSize="12"
                           LineHeight="17"
                           Foreground="{DynamicResource TextMutedBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusDetail}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- ============================== guncelleme bildirimi -->
                <Border CornerRadius="10" Margin="0,16,0,0" Padding="12,10"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderThickness="1" BorderBrush="{DynamicResource AccentBrush}"
                        Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <TextBlock Text="{Binding UpdateStatusText}"
                                   FontSize="12" Margin="0,0,84,0"
                                   TextWrapping="Wrap" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextBrush}" />
                        <Button Content="Simdi Guncelle"
                                Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Foreground="{DynamicResource AccentBrush}"
                                Command="{Binding ApplyUpdateCommand}" />
                    </Grid>
                </Border>

                <!-- ======================================= acilir ayarlar -->
                <Border x:Name="SettingsPanel" Height="0" ClipToBounds="True">
                    <StackPanel Margin="0,20,0,0">

                        <!-- Altyapi secimi -->
                        <TextBlock Text="ALTYAPI" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,7" />
                        <Grid>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,56,0">
                                <TextBlock Text="Kendi motorumuz"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Text="Kapaliyken hazir GoodbyeDPI altyapisi kullanilir"
                                           FontSize="11" Margin="0,2,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                            <ToggleButton Style="{StaticResource Switch}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                          IsChecked="{Binding IsNativeEngine, Mode=TwoWay}" />
                        </Grid>

                        <!-- Yontem: kendi motoru -->
                        <StackPanel Visibility="{Binding ShowNativeSettings, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="YONTEM" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,14,0,7" />
                            <ListBox Style="{StaticResource PillList}"
                                     ItemsSource="{Binding NativeProfiles}"
                                     SelectedItem="{Binding SelectedNativeProfile, Mode=TwoWay}"
                                     DisplayMemberPath="Name" />

                            <!-- Ozel motor ayarlari -->
                            <Border CornerRadius="10" Background="{DynamicResource SurfaceBrush}"
                                    Padding="12" Margin="0,10,0,0"
                                    Visibility="{Binding ShowCustomNative, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="Sahte paketin TTL degeri" FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextBrush}" />
                                        <TextBox Style="{StaticResource InputBox}"
                                                 Width="64" HorizontalAlignment="Right"
                                                 Text="{Binding NativeTtl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>

                                    <Grid Margin="0,8,0,0">
                                        <TextBlock Text="Sahte paket gonder" FontSize="12" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextBrush}" />
                                        <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                                      IsChecked="{Binding NativeFakePacket, Mode=TwoWay}" />
                                    </Grid>
                                    <Grid Margin="0,8,0,0">
                                        <TextBlock Text="Dusuk TTL kullan" FontSize="12" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextBrush}" />
                                        <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                                      IsChecked="{Binding NativeFakeTtl, Mode=TwoWay}" />
                                    </Grid>
                                    <Grid Margin="0,8,0,0">
                                        <TextBlock Text="Yanlis saglama (checksum)" FontSize="12" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextBrush}" />
                                        <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                                      IsChecked="{Binding NativeWrongChecksum, Mode=TwoWay}" />
                                    </Grid>
                                    <Grid Margin="0,8,0,0">
                                        <TextBlock Text="Yanlis SEQ/ACK" FontSize="12" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextBrush}" />
                                        <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                                      IsChecked="{Binding NativeWrongSeq, Mode=TwoWay}" />
                                    </Grid>
                                    <Grid Margin="0,8,0,0">
                                        <TextBlock Text="TLS ClientHello'yu bol" FontSize="12" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextBrush}" />
                                        <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                                      IsChecked="{Binding NativeSplitTls, Mode=TwoWay}" />
                                    </Grid>
                                    <Grid Margin="0,8,0,0">
                                        <TextBlock Text="Parcalari ters sirada gonder" FontSize="12" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextBrush}" />
                                        <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                                      IsChecked="{Binding NativeReverseSplit, Mode=TwoWay}" />
                                    </Grid>
                                    <Grid Margin="0,8,0,0">
                                        <TextBlock Text="QUIC (UDP 443) engelle" FontSize="12" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextBrush}" />
                                        <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                                      IsChecked="{Binding NativeBlockQuic, Mode=TwoWay}" />
                                    </Grid>
                                    <Grid Margin="0,8,0,0">
                                        <TextBlock Text="HTTP isteklerini de parcala" FontSize="12" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextBrush}" />
                                        <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                                      IsChecked="{Binding NativeFragmentHttp, Mode=TwoWay}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Yontem: hazir GoodbyeDPI -->
                        <StackPanel Visibility="{Binding ShowNativeSettings, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                            <TextBlock Text="YONTEM (GoodbyeDPI)" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,14,0,7" />
                            <ListBox Style="{StaticResource PillList}"
                                     ItemsSource="{Binding Methods}"
                                     SelectedItem="{Binding SelectedMethod, Mode=TwoWay}"
                                     DisplayMemberPath="Name" />
                        </StackPanel>

                        <!-- DNS -->
                        <TextBlock Text="DNS" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,14,0,7" />
                        <ListBox Style="{StaticResource PillList}"
                                 ItemsSource="{Binding DnsProfiles}"
                                 SelectedItem="{Binding SelectedDns, Mode=TwoWay}"
                                 DisplayMemberPath="Name" />

                        <!-- Ozel DNS girisi -->
                        <Border CornerRadius="10" Background="{DynamicResource SurfaceBrush}"
                                Padding="12" Margin="0,10,0,0"
                                Visibility="{Binding ShowCustomDns, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="Kendi DNS sunucun" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="72" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Style="{StaticResource InputBox}"
                                             Text="{Binding DnsCustomV4, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             ToolTip="IPv4 DNS adresi, orn. 8.8.8.8" />
                                    <TextBox Grid.Column="1" Style="{StaticResource InputBox}" Margin="6,0,0,0"
                                             Text="{Binding DnsCustomV4Port, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             ToolTip="Port" />
                                </Grid>
                                <TextBlock Text="IPv4 adresi : port" FontSize="10" Margin="2,3,0,0"
                                           Foreground="{DynamicResource TextMutedBrush}" />

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="72" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Style="{StaticResource InputBox}"
                                             Text="{Binding DnsCustomV6, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             ToolTip="IPv6 DNS adresi (istege bagli)" />
                                    <TextBox Grid.Column="1" Style="{StaticResource InputBox}" Margin="6,0,0,0"
                                             Text="{Binding DnsCustomV6Port, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             ToolTip="Port" />
                                </Grid>
                                <TextBlock Text="IPv6 adresi : port (istege bagli)" FontSize="10" Margin="2,3,0,0"
                                           Foreground="{DynamicResource TextMutedBrush}" />

                                <TextBlock Text="{Binding DnsWarning}" FontSize="11" Margin="0,8,0,0"
                                           TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}"
                                           Visibility="{Binding HasDnsWarning, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Border>

                        <Border Height="1" Background="{DynamicResource StrokeBrush}" Margin="0,14,0,0" />

                        <!-- Windows ile baslat -->
                        <Grid Margin="0,14,0,0">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,56,0">
                                <TextBlock Text="Windows ile baslat"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Text="Acilista tepside sessizce baslar"
                                           FontSize="11" Margin="0,2,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>

                            <ToggleButton Style="{StaticResource Switch}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                          IsChecked="{Binding RunAtStartup, Mode=TwoWay}" />
                        </Grid>

                        <!-- Otomatik baglan -->
                        <Grid Margin="0,14,0,0">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,56,0">
                                <TextBlock Text="Otomatik baglan"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Text="Uygulama acilir acilmaz baglantiyi baslatir"
                                           FontSize="11" Margin="0,2,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>

                            <ToggleButton Style="{StaticResource Switch}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                          IsChecked="{Binding AutoConnect, Mode=TwoWay}" />
                        </Grid>

                        <!-- Otomatik guncelle -->
                        <Grid Margin="0,14,0,0">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,56,0">
                                <TextBlock Text="Otomatik guncelle"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Text="Acilista GitHub'da yeni surum varsa kurar"
                                           FontSize="11" Margin="0,2,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>

                            <ToggleButton Style="{StaticResource Switch}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                          IsChecked="{Binding AutoUpdate, Mode=TwoWay}" />
                        </Grid>

                        <!-- Gorev olusturulamadiysa sebebini goster -->
                        <TextBlock Text="{Binding StartupWarning}"
                                   FontSize="11"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource DangerBrush}"
                                   Visibility="{Binding HasStartupWarning, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!--
            Tema capraz gecisi.

            Canvas icinde duruyor cunku Canvas'in istenen boyutu her zaman sifir:
            anlik goruntu gorunur oldugunda pencereyi asagi dogru buyutup sonra
            geri kucultmesini bu engelliyor (SizeToContent="Height" ile birlikte
            dogrudan Grid'e konursa pencere zipliyordu).
            Boyutu yakalama aninda kod tarafindan veriliyor.
        -->
        <Canvas IsHitTestVisible="False">
            <Image x:Name="ThemeFade"
                   Stretch="Fill"
                   Opacity="0"
                   Visibility="Collapsed" />
        </Canvas>
    </Grid>
</Window>
