<Application x:Class="GoodbyeDpiUI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                    SIRA ONEMLI: ThemeService, 1 numarali sozlugu (tema paleti)
                    Light/Dark ile takas ediyor. Araya yeni sozluk eklerken
                    ThemeService.ThemeDictionaryIndex degerini de guncelleyin.
                -->
                <ResourceDictionary Source="Themes/Shared.xaml" />
                <ResourceDictionary Source="Themes/Light.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
