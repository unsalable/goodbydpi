<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <!--
        Koyu tema paleti. ThemeService bu sozlugu App.Resources icinde
        digeriyle takas eder; tum XAML {DynamicResource ...} kullandigi icin
        degisiklik aninda her yere yansir.

        Fircalar bilerek donduruluyor (po:Freeze): WPF zaten sozluge konan her
        Freezable'i muhurluyor, acikca dondurmek cizimi de hizlandiriyor.
        Tema gecisinin yumusakligi renk animasyonundan degil, MainWindow'un
        eski goruntuyu ustte tutup soldurmasindan geliyor.

        Iki dosyadaki anahtarlar birebir ayni kalmali.
    -->

    <SolidColorBrush x:Key="BgBrush"            Color="#FF0E1014" po:Freeze="True" />
    <SolidColorBrush x:Key="SurfaceBrush"       Color="#FF171A21" po:Freeze="True" />
    <SolidColorBrush x:Key="SurfaceAltBrush"    Color="#FF1E222B" po:Freeze="True" />
    <SolidColorBrush x:Key="StrokeBrush"        Color="#FF2A2F3A" po:Freeze="True" />
    <SolidColorBrush x:Key="TextBrush"          Color="#FFF1F5F9" po:Freeze="True" />
    <SolidColorBrush x:Key="TextMutedBrush"     Color="#FF94A3B8" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentBrush"        Color="#FF818CF8" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentAltBrush"     Color="#FFA78BFA" po:Freeze="True" />
    <SolidColorBrush x:Key="SuccessBrush"       Color="#FF34D399" po:Freeze="True" />
    <SolidColorBrush x:Key="DangerBrush"        Color="#FFF87171" po:Freeze="True" />
    <SolidColorBrush x:Key="TrackBrush"         Color="#FF232833" po:Freeze="True" />

    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
        <GradientStop Color="#FF818CF8" Offset="0" />
        <GradientStop Color="#FFA78BFA" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
