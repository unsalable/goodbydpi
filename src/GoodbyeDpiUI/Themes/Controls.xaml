<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:svc="clr-namespace:GoodbyeDpiUI.Services">

    <sys:Double x:Key="PowerSize">168</sys:Double>

    <svc:BoolToVisibilityConverter x:Key="BoolToVis" />

    <!-- ================================================== hareket egrileri -->
    <!--
        Storyboard'larda kullanilan ortak egriler. Koddan yapilan gecisler (Services/Motion,
        PopupMotion, SmoothScroll) ayni yay egrisini kullanir; arayuzun her yeri ayni
        "fizikle" hareket etsin diye yeni animasyonlar da buradan beslenmeli.

        Renk degisimleri Setter ile degil, ustte duran katmanin opakligi soldurularak
        yapiliyor: temadaki muhurlu fircalarin rengi animasyonlanamiyor.
    -->
    <svc:SpringEase x:Key="Spring" />
    <svc:SpringEase x:Key="SpringSoft" Bounce="0.15" />
    <svc:SpringEase x:Key="SpringBouncy" Bounce="0.32" />
    <QuadraticEase x:Key="EaseOut" EasingMode="EaseOut" />
    <CubicEase x:Key="EaseOutStrong" EasingMode="EaseOut" />

    <!-- ================================================== metin girisi -->
    <Style x:Key="InputBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Height" Value="32" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border CornerRadius="8" Background="{DynamicResource SurfaceAltBrush}" Padding="10,0">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Border>
                        <Border CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource StrokeBrush}"
                                IsHitTestVisible="False" Opacity="0"
                                svc:Motion.Show="{TemplateBinding IsMouseOver}" />
                        <Border CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource AccentBrush}"
                                IsHitTestVisible="False" Opacity="0"
                                svc:Motion.Show="{TemplateBinding IsKeyboardFocused}" />
                        <Border x:Name="ErrorRing" CornerRadius="8" BorderThickness="1"
                                BorderBrush="{DynamicResource DangerBrush}"
                                IsHitTestVisible="False" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="ErrorRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <!-- WPF'in varsayilan kirmizi dogrulama cercevesi yerine sablondaki kenarlik renkleniyor. -->
        <Setter Property="Validation.ErrorTemplate">
            <Setter.Value>
                <ControlTemplate>
                    <AdornedElementPlaceholder />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================== bolum basligi / ayar satiri -->

    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="Margin" Value="0,18,0,8" />
    </Style>

    <Style x:Key="RowTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="RowHint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>

    <!-- Ozel ayar kutusundaki grup basligi (kutunun icinde, daha sik). -->
    <Style x:Key="GroupLabel" TargetType="TextBlock" BasedOn="{StaticResource SectionLabel}">
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!--
        Ozel ayar kutusundaki tek satir: solda metin (+ istege bagli aciklama),
        sagda anahtar ya da giris kutusu. Pasif olunca tum satir yumusakca soluklasir.
    -->
    <Style x:Key="OptionRow" TargetType="Grid">
        <Setter Property="Margin" Value="0,10,0,0" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.4" Duration="0:0:0.22"
                                             EasingFunction="{StaticResource EaseOut}" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.22"
                                             EasingFunction="{StaticResource EaseOut}" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="OptionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <Style x:Key="OptionHint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Margin" Value="0,1,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>

    <Style x:Key="GroupDivider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="0,14,0,12" />
        <Setter Property="Background" Value="{DynamicResource StrokeBrush}" />
    </Style>

    <!-- ==================================================== ince kaydirma cubugu -->
    <!--
        Govde pencereye sigmadiginda gorunen, temaya uyan ince cubuk. Icerigin
        ustunde durur (yer kaplamaz); govdenin yan boslugu zaten 24 px.
        Imlec alanin disindayken soner, cubugun ustune gelince kalinlasir.
    -->

    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent">
                        <Border x:Name="Bar" Width="4" CornerRadius="3" HorizontalAlignment="Center"
                                Background="{DynamicResource StrokeBrush}" />
                        <Border x:Name="BarHot" Width="4" CornerRadius="3" HorizontalAlignment="Center"
                                Background="{DynamicResource TextMutedBrush}" Opacity="0"
                                svc:Motion.Show="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ScrollBar}}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="Width"
                                                         To="6" Duration="0:0:0.3" EasingFunction="{StaticResource SpringSoft}" />
                                        <DoubleAnimation Storyboard.TargetName="BarHot" Storyboard.TargetProperty="Width"
                                                         To="6" Duration="0:0:0.3" EasingFunction="{StaticResource SpringSoft}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="Width"
                                                         To="4" Duration="0:0:0.35" EasingFunction="{StaticResource Spring}" />
                                        <DoubleAnimation Storyboard.TargetName="BarHot" Storyboard.TargetProperty="Width"
                                                         To="4" Duration="0:0:0.35" EasingFunction="{StaticResource Spring}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="BarHot" Property="Background" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ThinScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="8" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageUpCommand" />
                        </Track.DecreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Style="{StaticResource ScrollThumb}" MinHeight="28" />
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageDownCommand" />
                        </Track.IncreaseRepeatButton>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Tekerlekle yumusak kaydirma (SmoothScroll) bu stili kullanan her alanda acik:
        pencere govdesi ve acilir listeler. Seffaf arka plan, bosluklarin ustunde de
        tekerlegin ve imlecin alani gormesini sagliyor.
    -->
    <Style x:Key="ThinScrollViewer" TargetType="ScrollViewer">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="svc:SmoothScroll.IsEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid Background="Transparent">
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                CanContentScroll="{TemplateBinding CanContentScroll}" />
                        <ScrollBar x:Name="PART_VerticalScrollBar"
                                   Style="{StaticResource ThinScrollBar}"
                                   Orientation="Vertical"
                                   HorizontalAlignment="Right"
                                   Margin="0,4,6,10"
                                   Minimum="0"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Value="{TemplateBinding VerticalOffset}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                   Opacity="0"
                                   svc:Motion.Show="{TemplateBinding IsMouseOver}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================================================== baslik cubugu dugmeleri -->
    <!-- Uzerine gelince zemin solarak belirir, basinca simge yay gibi icine cokup geri esner. -->

    <Style x:Key="TitleBarButton" TargetType="Button">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="{TemplateBinding Background}">
                        <Border CornerRadius="7" Background="{DynamicResource SurfaceAltBrush}" Opacity="0"
                                svc:Motion.Show="{TemplateBinding IsMouseOver}" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          svc:Motion.Pressed="{TemplateBinding IsPressed}"
                                          svc:Motion.PressScale="0.84" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Kapat dugmesi ayni davranir ama uzerine gelince kirmizi zemin solarak gelir. -->
    <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border CornerRadius="7" Background="{DynamicResource DangerBrush}" Opacity="0"
                                svc:Motion.Show="{TemplateBinding IsMouseOver}" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          svc:Motion.Pressed="{TemplateBinding IsPressed}"
                                          svc:Motion.PressScale="0.84" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================== guc dugmesi -->
    <!--
        Kompozisyon (disdan ice): nabiz halkasi > ray > donen yay > govde > glif.

        Her durumun (bagli, baglaniyor, hata) kendi ray / govde / glif katmani var ve
        opakligi durum ozelligine bagli soluyor; durumlar arasi gecis boylece capraz
        gecis oluyor, renk bir karede ziplamiyor. Uzerine gelme ve basma ayri olcekler
        oldugu icin birbirini ezmiyor.

        Nabiz ve donme yalnizca ilgili durumda ve pencere gorunurken calisir; kapali
        durumda hicbir storyboard donmez, yani bosta CPU kullanimi sifira iner.
    -->

    <Style x:Key="PowerGlyph" TargetType="Path">
        <Setter Property="StrokeThickness" Value="5" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Data" Value="M 67.15,73.86 A 22,22 0 1 0 100.85,73.86 M 84,58 L 84,84" />
    </Style>

    <Style x:Key="PowerTrack" TargetType="Ellipse">
        <Setter Property="Margin" Value="6" />
        <Setter Property="StrokeThickness" Value="4" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <Style x:Key="PowerButton" TargetType="Button">
        <Setter Property="Width" Value="{StaticResource PowerSize}" />
        <Setter Property="Height" Value="{StaticResource PowerSize}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent"
                          svc:Motion.Hovered="{TemplateBinding IsMouseOver}" svc:Motion.HoverScale="1.04"
                          svc:Motion.Pressed="{TemplateBinding IsPressed}" svc:Motion.PressScale="0.93">

                        <!-- Nabiz halkasi: baglandiginda disari dogru genisleyip soner. -->
                        <Ellipse x:Name="Pulse"
                                 Margin="4"
                                 Opacity="0"
                                 IsHitTestVisible="False"
                                 Fill="{DynamicResource SuccessBrush}"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="PulseScale" ScaleX="1" ScaleY="1" />
                            </Ellipse.RenderTransform>
                        </Ellipse>

                        <!-- Ray: bosta, hata ve bagli renkleri ust uste -->
                        <Ellipse Style="{StaticResource PowerTrack}" Stroke="{DynamicResource TrackBrush}" />
                        <Ellipse Style="{StaticResource PowerTrack}" Stroke="{DynamicResource DangerBrush}"
                                 Opacity="0" svc:Motion.Show="{Binding IsFailed}" />
                        <Ellipse Style="{StaticResource PowerTrack}" Stroke="{DynamicResource SuccessBrush}"
                                 Opacity="0" svc:Motion.Show="{Binding IsConnected}" />

                        <!-- Baglaniyor durumundaki donen yay -->
                        <Path x:Name="Arc"
                              Opacity="0"
                              IsHitTestVisible="False"
                              svc:Motion.Show="{Binding IsConnecting}"
                              Stroke="{DynamicResource AccentBrush}"
                              StrokeThickness="4"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M 84,6 A 78,78 0 0 1 162,84"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <RotateTransform x:Name="ArcRotate" Angle="0" />
                            </Path.RenderTransform>
                        </Path>

                        <!-- Govde ve glif: baglaninca birlikte hafifce icine cokup yay ile oturur. -->
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="BodyScale" ScaleX="1" ScaleY="1" />
                            </Grid.RenderTransform>

                            <Ellipse Margin="20" IsHitTestVisible="False" Fill="{DynamicResource SurfaceAltBrush}" />
                            <Ellipse Margin="20" IsHitTestVisible="False" Fill="{DynamicResource AccentGradient}"
                                     Opacity="0" svc:Motion.Show="{Binding IsConnected}" />

                            <Path Style="{StaticResource PowerGlyph}" Stroke="{DynamicResource TextMutedBrush}"
                                  Opacity="0" svc:Motion.Show="{Binding IsIdle}" />
                            <Path Style="{StaticResource PowerGlyph}" Stroke="{DynamicResource DangerBrush}"
                                  Opacity="0" svc:Motion.Show="{Binding IsFailed}" />
                            <Path Style="{StaticResource PowerGlyph}" Stroke="{DynamicResource AccentBrush}"
                                  Opacity="0" svc:Motion.Show="{Binding IsConnecting}" />
                            <Path Style="{StaticResource PowerGlyph}" Stroke="White"
                                  Opacity="0" svc:Motion.Show="{Binding IsConnected}" />
                        </Grid>
                    </Grid>

                    <ControlTemplate.Triggers>

                        <!-- Baglanti kuruldugu an: govde kisa bir an icine cokup esneyerek yerine oturur. -->
                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BodyScale" Storyboard.TargetProperty="ScaleX">
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.12" Value="0.92" EasingFunction="{StaticResource EaseOut}" />
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.82" Value="1" EasingFunction="{StaticResource SpringBouncy}" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BodyScale" Storyboard.TargetProperty="ScaleY">
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.12" Value="0.92" EasingFunction="{StaticResource EaseOut}" />
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.82" Value="1" EasingFunction="{StaticResource SpringBouncy}" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>

                        <!--
                            Surekli donen storyboard'lar yalnizca pencere gorunurken calisir.
                            AreAnimationsEnabled tepsiye kucululdugunde false olur ve
                            animasyon saatleri tamamen durur - bosta CPU kullanimi sifir.
                            Yay durdurulurken yerinde birakiliyor (Pause): solarak kaybolurken
                            basa ziplamasin.
                        -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsConnecting}" Value="True" />
                                <Condition Binding="{Binding AreAnimationsEnabled}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard x:Name="SpinStory">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ArcRotate"
                                                         Storyboard.TargetProperty="Angle"
                                                         From="0" To="360" Duration="0:0:1.1"
                                                         RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <PauseStoryboard BeginStoryboardName="SpinStory" />
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>

                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsConnected}" Value="True" />
                                <Condition Binding="{Binding AreAnimationsEnabled}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard x:Name="PulseStory">
                                    <!-- Efekt yerine duz elips olcekliyoruz: GPU'da neredeyse bedava. -->
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="PulseScale" Storyboard.TargetProperty="ScaleX"
                                                         From="0.92" To="1.17" Duration="0:0:2.4"
                                                         EasingFunction="{StaticResource EaseOutStrong}" />
                                        <DoubleAnimation Storyboard.TargetName="PulseScale" Storyboard.TargetProperty="ScaleY"
                                                         From="0.92" To="1.17" Duration="0:0:2.4"
                                                         EasingFunction="{StaticResource EaseOutStrong}" />
                                        <DoubleAnimation Storyboard.TargetName="Pulse" Storyboard.TargetProperty="Opacity"
                                                         From="0.3" To="0" Duration="0:0:2.4"
                                                         EasingFunction="{StaticResource EaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="PulseStory" />
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================= anahtar -->
    <!--
        iOS anahtari gibi: dugme yay ile esneyerek kayar, zemin rengi solarak gecer,
        basili tutulurken dugme kayacagi yone dogru uzar.
    -->

    <Style x:Key="Switch" TargetType="ToggleButton">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <Border CornerRadius="13" Background="{DynamicResource TrackBrush}" />
                        <Border CornerRadius="13" Background="{DynamicResource AccentBrush}" Opacity="0"
                                svc:Motion.Show="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" />
                        <Border x:Name="Thumb"
                                Width="20" Height="20"
                                CornerRadius="10"
                                Background="White"
                                HorizontalAlignment="Left"
                                Margin="3,0,0,0">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="ThumbShift" X="0" />
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.28" Color="#000000" />
                            </Border.Effect>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbShift" Storyboard.TargetProperty="X"
                                                         To="18" Duration="0:0:0.5" EasingFunction="{StaticResource SpringBouncy}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbShift" Storyboard.TargetProperty="X"
                                                         To="0" Duration="0:0:0.5" EasingFunction="{StaticResource SpringBouncy}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!-- Basili: dugme uzar. Kapaliyken saga, acikken sola dogru. -->
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="Width"
                                                         To="25" Duration="0:0:0.16" EasingFunction="{StaticResource EaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="Width"
                                                         To="20" Duration="0:0:0.45" EasingFunction="{StaticResource SpringSoft}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!--
                            Birakinca once IsPressed duser (bu cikis X'i 18'e dondurur), hemen
                            ardindan tiklama IsChecked'i degistirir ve onun animasyonu son soze sahip olur.
                        -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsPressed" Value="True" />
                                <Condition Property="IsChecked" Value="True" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbShift" Storyboard.TargetProperty="X"
                                                         To="13" Duration="0:0:0.16" EasingFunction="{StaticResource EaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbShift" Storyboard.TargetProperty="X"
                                                         To="18" Duration="0:0:0.45" EasingFunction="{StaticResource SpringSoft}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================================================== secim hapi (pill) -->
    <!-- Tepsi panelindeki yontem ve DNS secimi: yatay hap listesi. -->

    <Style x:Key="PillList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <!--
            Foreground'u ACIKCA vermek sart. WPF'in yerlesik ListBox temasi
            Foreground'u SystemColors.ControlTextBrushKey'den (siyah) aliyor ve bu,
            pencereden gelen mirasi eziyor. Belirtilmedigi surece koyu temada
            haplarin yazisi siyah zemine siyah dusup gorunmez oluyordu.
        -->
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <!--
            Varsayilan ListBox sablonu kendi ScrollViewer'ini tasiyor ve kaydiracak bir
            sey olmasa bile fare tekerlegi olayini yutuyor: imlec haplarin ustundeyken
            pencere govdesi kaydirilamiyordu. Bu sablonda ScrollViewer yok.
        -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Margin" Value="0,0,6,6" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <!--
                                Secili zemin ve beyaz yazi ustten solarak gelir; normal yazi ayni
                                anda soner. Tek bir yaziyi renklendirmek ani degisim olurdu.
                            -->
                            <ControlTemplate TargetType="ListBoxItem">
                                <Grid>
                                    <Border CornerRadius="9" Background="{DynamicResource SurfaceAltBrush}" />
                                    <Border CornerRadius="9" BorderThickness="1" BorderBrush="{DynamicResource StrokeBrush}"
                                            Opacity="0" svc:Motion.Show="{TemplateBinding IsMouseOver}" />
                                    <Border CornerRadius="9" Background="{DynamicResource AccentBrush}"
                                            Opacity="0" svc:Motion.Show="{TemplateBinding IsSelected}" />
                                    <ContentPresenter Margin="11,6"
                                                      TextElement.Foreground="{DynamicResource TextBrush}"
                                                      svc:Motion.Hide="{TemplateBinding IsSelected}" />
                                    <ContentPresenter Margin="11,6"
                                                      TextElement.Foreground="White"
                                                      Opacity="0" svc:Motion.Show="{TemplateBinding IsSelected}" />
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================= acilir secim listesi -->
    <!--
        Secenek sayisi arttikca hap listesi paneli sisiriyordu. Kapaliyken yalnizca
        secili ogenin adini gosteren, acilinca her ogeyi adi + aciklamasiyla listeleyen
        ComboBox. Ogelerde Name ve Description ozellikleri olmali (ISS, yontem, DNS).
    -->

    <Style x:Key="DropdownItem" TargetType="ComboBoxItem">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Grid Background="Transparent">
                        <!-- Secili zemin ve uzerine gelme vurgusu ayri katmanlar: vurgu ogeler arasinda suzulur. -->
                        <Border CornerRadius="8" Background="{DynamicResource SurfaceAltBrush}"
                                Opacity="0" svc:Motion.Show="{TemplateBinding IsSelected}" />
                        <Border CornerRadius="8" Background="{DynamicResource SurfaceAltBrush}"
                                Opacity="0" svc:Motion.Show="{TemplateBinding IsHighlighted}" />
                        <Grid Margin="10,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Description}" FontSize="11" Margin="0,1,0,0"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Path Grid.Column="1" Margin="10,0,2,0"
                                  VerticalAlignment="Center"
                                  Opacity="0" svc:Motion.Show="{TemplateBinding IsSelected}"
                                  Data="M 0,5 L 4,9 L 12,1" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Stroke="{DynamicResource AccentBrush}" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DropdownToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border CornerRadius="10" Background="{DynamicResource SurfaceAltBrush}" />
                        <Border CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource StrokeBrush}"
                                Opacity="0" svc:Motion.Show="{TemplateBinding IsMouseOver}" />
                        <Border CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource AccentBrush}"
                                Opacity="0"
                                svc:Motion.Show="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Acilir panel PopupMotion ile acilip kapanir: kutunun kenarindan hafif buyuyup
        yay ile oturur, kapanirken kisa bir solmayla kaybolur. Popup.IsOpen bu yuzden
        dogrudan IsDropDownOpen'a bagli degil.
    -->
    <Style x:Key="Dropdown" TargetType="ComboBox">
        <Setter Property="Height" Value="40" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource DropdownItem}" />
        <Setter Property="MaxDropDownHeight" Value="300" />
        <!--
            WPF'in ComboBox tema stili oge bazli kaydirmayi aciyor ve sablondaki ScrollViewer
            bunu sessizce devraliyor: liste piksel yerine birer oge ziplardi. Piksel bazli
            olunca tekerlekle yumusak kaydirma listede de calisiyor.
        -->
        <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid svc:Motion.Pressed="{Binding IsPressed, ElementName=Toggle}" svc:Motion.PressScale="0.985">
                        <ToggleButton x:Name="Toggle"
                                      Style="{StaticResource DropdownToggle}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <Grid Margin="13,0,12,0" IsHitTestVisible="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding SelectedItem.Name, RelativeSource={RelativeSource TemplatedParent}, NotifyOnTargetUpdated=True}"
                                       svc:Motion.RefreshText="True"
                                       VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <Path Grid.Column="1" VerticalAlignment="Center"
                                  Data="M 0,0 L 5,5 L 10,0" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Stroke="{DynamicResource TextMutedBrush}"
                                  svc:Motion.Turned="{TemplateBinding IsDropDownOpen}" />
                        </Grid>

                        <Popup x:Name="PART_Popup"
                               svc:PopupMotion.IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom" VerticalOffset="2" HorizontalOffset="-8"
                               AllowsTransparency="True"
                               Focusable="False">
                            <!-- Golgeye yer acmak icin kenar boslugu birakiliyor. -->
                            <Border Margin="8,2,8,12"
                                    Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    CornerRadius="12" Padding="5,5,5,3"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderThickness="1" BorderBrush="{DynamicResource StrokeBrush}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.35" Direction="270" />
                                </Border.Effect>
                                <ScrollViewer Style="{StaticResource ThinScrollViewer}">
                                    <ItemsPresenter Margin="0,0,10,0" KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================= birincil eylem dugmesi -->
    <!-- Tepsi panelindeki Baglan / Baglantiyi Kes dugmesi. -->

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Height" Value="40" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid svc:Motion.Hovered="{TemplateBinding IsMouseOver}" svc:Motion.HoverScale="1.02"
                          svc:Motion.Pressed="{TemplateBinding IsPressed}" svc:Motion.PressScale="0.96">
                        <Border CornerRadius="11" Background="{DynamicResource AccentGradient}" />
                        <!-- Bagliyken eylem "kes" oldugu icin notr yuzey ustten solarak gelir. -->
                        <Border CornerRadius="11" Background="{DynamicResource SurfaceAltBrush}"
                                Opacity="0" svc:Motion.Show="{Binding IsConnected}" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================== metin dugmesi -->
    <!-- Tag="danger" verilirse uzerine gelince kirmiziya doner. -->

    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border CornerRadius="8" Background="{DynamicResource SurfaceAltBrush}"
                                Opacity="0" svc:Motion.Show="{TemplateBinding IsMouseOver}" />
                        <ContentPresenter Margin="9,5"
                                          svc:Motion.Pressed="{TemplateBinding IsPressed}"
                                          svc:Motion.PressScale="0.94" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="Tag" Value="danger" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
